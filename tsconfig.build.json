{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "types": [
            "node"
        ],
        "strict": true,
        "newLine": "LF",
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "stripInternal": true,
        "typeRoots": [
            "node_modules/@types",
            "src/typings"
        ],
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts"
    ]
}