{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "types": ["node"],
        "newLine": "LF",
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictBindCallApply": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "stripInternal": true,
        "typeRoots": [
            "node_modules/@types",
            "src/typings"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}