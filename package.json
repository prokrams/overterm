{
  "name": "overterm",
  "version": "0.4.0",
  "description": "Terminal ASCII timer with tracking of completed work. Lightweight, ASCII, time.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prokrams/overterm.git"
  },
  "type": "module",
  "bin": {
